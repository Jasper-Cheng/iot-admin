{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vben/tsconfig/web-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "src/views/device/thing-model/modules/events-modal.vue",
    "src/views/device/thing-model/modules/properties-modal.vue",
    "src/views/device/thing-model/modules/services-modal.vue"
  ]
}
